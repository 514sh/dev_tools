# Developer Dev Tools - Environment Configuration
# Copy this file to .env and customize values as needed

# =============================================================================
# NETWORK
# =============================================================================
DEVTOOLS_NETWORK=dev-tools

# =============================================================================
# PORT CONFIGURATION
# =============================================================================
# If you have local services using the same ports, change these to avoid conflicts.
# Default ports are shown. Docker containers will be accessible at these host ports.
# 
# Common conflict resolution: add 1000 to standard ports (5432 -> 15432)
# Or use +1 offset (5432 -> 5433)
# =============================================================================

# =============================================================================
# POSTGRESQL
# =============================================================================
POSTGRES_VERSION=15
POSTGRES_USER=devtools
POSTGRES_PASSWORD=devtools_secret_password
POSTGRES_DB=devtools
# POSTGRES_PORT=5432        # Default - change if port in use
# Example alternate: 15432   # (5432 + 1000)

# =============================================================================
# MONGODB
# =============================================================================
MONGODB_VERSION=7
MONGO_INITDB_ROOT_USERNAME=devtools
MONGO_INITDB_ROOT_PASSWORD=devtools_secret_password
# MONGODB_PORT=27017        # Default - change if port in use
# Example alternate: 27018   # (27017 + 1)

# =============================================================================
# REDIS
# =============================================================================
REDIS_VERSION=7
REDIS_PASSWORD=devtools_redis_password
# REDIS_PORT=16379           # Default - change if port in use

# =============================================================================
# MEILISEARCH
# =============================================================================
MEILISEARCH_VERSION=1.6.1
MEILI_MASTER_KEY=devtools_meilisearch_master_key
# MEILISEARCH_PORT=7700      # Default - change if port in use
# Example alternate: 17700   # (7700 + 10000)

# =============================================================================
# QDRANT (Vector Database)
# =============================================================================
QDRANT_VERSION=1.7.4
QDRANT_API_KEY=devtools_qdrant_api_key
# QDRANT_PORT=6333           # Default - change if port in use
# QDRANT_GRPC_PORT=6334      # Default - change if port in use
# Example alternate: 16333, 16334

# =============================================================================
# OLLAMA (Local LLM)
# =============================================================================
OLLAMA_VERSION=latest
OLLAMA_HOST=0.0.0.0:11435
# OLLAMA_PORT=11435          # Default - change if port in use
# Example alternate: 11436   # (11435 + 1)
# OLLAMA_MODELS=/path/to/models (uncomment and set to persist models)

# =============================================================================
# N8N (Workflow Automation)
# =============================================================================
N8N_VERSION=latest
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=devtools_n8n_password
# N8N_PORT=5678             # Default - change if port in use
# Example alternate: 15678   # (5678 + 10000)

# =============================================================================
# TRAEFIK (Reverse Proxy)
# =============================================================================
TRAEFIK_VERSION=3.0
# TRAEFIK_HTTP_PORT=80       # Default - requires root, change if in use
# TRAEFIK_HTTPS_PORT=443    # Default - requires root, change if in use
# Example alternate: 8080, 8443
# TRAEFIK_DASHBOARD_PORT=8090  # Default - change if port in use
# Example alternate: 18090   # (8090 + 10000)
# TRAEFIK_ACME_EMAIL=your@email.com (uncomment for Let's Encrypt)

# =============================================================================
# ROTATING TOR PROXY
# =============================================================================
TOR_VERSION=latest
TOR_CONTROL_PASSWORD=devtools_tor_control_password
# TOR_SOCKS_PORT=9050       # Default - change if port in use
# TOR_CONTROL_PORT=9051     # Default - change if port in use
# TOR_HTTP_PORT=8118        # Default - change if port in use
# Example alternates: 19050, 19051, 18118
# TOR_CIRCUIT_RENEW_INTERVAL=600 (default 10 minutes, uncomment to change)

# =============================================================================
# CELERY WORKER EXAMPLE
# =============================================================================
# These use internal container networking, not host ports
CELERY_BROKER_URL=redis://:devtools_redis_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:devtools_redis_password@redis:6379/1
